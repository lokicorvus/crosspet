<Project Sdk="Microsoft.NET.Sdk">
  <!-- 试验 C：换掉 WebView2CompositionControl（截图贴进 WPF）后，新开桌宠窗口还卡不卡、透明和鼠标穿透行不行。
       独立的小程序，不进正式包：tests/windows/HostSpike/build.sh 打成 build/HostSpike.zip，拿到 Windows 上解压双击 HostSpike.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HostSpike</AssemblyName>
    <RootNamespace>HostSpike</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>../../../app/windows/app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
