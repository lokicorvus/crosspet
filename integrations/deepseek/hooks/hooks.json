{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/crosspet && python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" deepseek",
            "timeout": 5
          }
        ]
      }
    ]
  }
}