{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" workbuddy",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" workbuddy",
            "timeout": 5
          }
        ]
