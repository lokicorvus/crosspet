{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "name": "crosspet",
            "type": "command",
            "command": "python3 \"$HOME/Library/Application Support/CrossPet/crosspet-hook.py\" gemini",
            "timeout": 5000
          }
        ]
